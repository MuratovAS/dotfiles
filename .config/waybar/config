{
    "position": "top", 
    "height": 30,

	"modules-left": [
		"custom/menu",
		"sway/workspaces",
		"custom/scratchpad",
		"sway/mode"
	],
	/*"modules-center": [
		"sway/window"
	],*/
	"modules-right": [
		"network",
		"bluetooth",
		
		"battery",
		"temperature",
		"cpu",
		"memory",
		"backlight",
		"pulseaudio",
		
		"custom/sunset",
		"custom/playerctl",
		"idle_inhibitor",
		"custom/pacman",
		"tray",
		"sway/language",
		"custom/screencast",
		"clock",
		"custom/button",
	],

	"custom/menu": {
		"format": "",
		"on-click": "swaymsg exec \\$menu",
		"tooltip": false
	},
	
    // Modules configuration
	"sway/workspaces": {
		"active-only": true,
		"disable-scroll": true,
		"all-outputs": false,
		// "persistent-workspaces": {
		//     "1": ["DP-2", "DP-1"],
		//     "2": ["DP-2"],
		//     "3": ["DP-2"],
		//     "4": ["DP-2"],
		//     "5": ["DP-2"],
		//     "6": ["eDP-1"],
		//     "7": ["eDP-1"],
		//     "8": ["eDP-1"],
		//     "9": ["eDP-1"]
		// },
		"format": "{icon}",
		// "format-icons": {
		//    "1": "",
		//    "2": "",
		//    "3": "",
		//    "4": "",
		//    "5": "",
		//    "urgent": "",
		//    "active": "",
		//    "default": ""
		// },
	},
	"custom/button": {
		"format": "󰐥",
		"tooltip": false,
		"on-click": "swaymsg mode \\$mode_shutdown",
	},
	"clock": {
		"format": "󰅐 {:%H:%M}",
        	"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        	"format-alt": "󰸗 {:%Y-%m-%d}"
	},
	"battery": {
        	"states": {
            		"warning": 30,
            		"critical": 15,
        	},
        	"format": "{icon} {capacity}%",
        	"format-charging": "󰂄 {capacity}%",
        	"format-plugged": "󰂄 {capacity}%",
        	"format-alt": "{icon} {time}",
        	"format-full": "󱈑 {capacity}%",
			"format-icons": [
				"󰂃",
				//"󰁺", // Icon: battery-empty
				"󰁻", // Icon: battery-quarter
				"󰁽", // Icon: battery-half
				"󰂀", // Icon: battery-three-quarters
				"󰁹"  // Icon: battery-full
			],
			// "bat": "BAT0"
			// "tooltip": false,
	},
	"network": {
		//"interval": 5,
		"interface": "wlan0",
		//"min-length": 4,
		"format": "{ifname}",
	//"format-wifi": "󰖩 {signalStrength}%", // Icon: wifi
	//"format-ethernet": "󰈀 {ifname}", // Icon: ethernet
		"format-disconnected": "󱘖",
		//"format-wifi": "󰖩  {essid} ({signalStrength}%)", // Icon: wifi
		"tooltip-format": "{ifname}: {ipaddr}",
		"on-click": "swaymsg exec \\$term_float nmtui",
		
        	// "format-wifi": "  {essidd}",
        	"format-wifi": "  {ifname}",
        	"format-ethernet": " {ifname}",
        	"format-linked": " {ifname}!",
        	//"format-disconnected": "󰤮 Disconnected",
        	// "format-alt": "{ifname}: {ipaddr}/{cidr}"
	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰖁",
		"format-bluetooth": "{icon} 󰂰 {volume}%",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
		"on-click": "swaymsg exec \\$pulsemixer",
		"on-click-right": "swaymsg exec \\$mic_mute",
		"tooltip-format": "{icon}  {volume}% {format_source}",
		"on-scroll-up": "swaymsg exec \\$volume_up",
		"on-scroll-down": "swaymsg exec \\$volume_down"
    },

    
    "temperature": {
      //"min-length": 2,
      "interval": 2,
      "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
      "critical-threshold": 80,
      "warning-threshold": 70,
      "format": "{icon} {temperatureC}°C",
      "format-icons": ["", "", ""],
      "tooltip": false,
      "on-click": "swaymsg exec \"\\$term_float watch sensors\""
    },

    "tray": {
    	"icon-size": 20,
    	"spacing": 8
    },

    "bluetooth": {
    	"format": "",
    	"format-connected": "󰂱",
    	// "format-connected-battery": " {device_battery_percentage}%",
    	//"format-connected": " {device_alias}",
    	//"format-connected-battery": " {device_alias} {device_battery_percentage}%",
    	// "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    	"tooltip-format": "{controller_alias}\t{controller_address}",
    	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n{device_enumerate}",
    	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    	"on-click": "swaymsg exec \\$term_float bluetuith"
    },

    "sway/language": {
    	//"min-length": 5,
    	"format": " {}",
    	"tooltip": false,
    	"on-click": "swaymsg input $(swaymsg -t get_inputs --raw | jq '[.[] | select(.type == \"keyboard\")][0] | .identifier') xkb_switch_layout next"
    },

    "sway/mode": {
    	"format": "<span style=\"italic\">{}</span>",
    	"tooltip": false
    },

    /*"sway/window": {
    	"format": "{}",
    	"max-length": 50
    },*/

    "backlight": {
    	"format": "{icon} {percent}%",
    	"format-icons": ["󰃞", "󰃟", "󰃠"],
    	"on-scroll-down": "swaymsg exec \\$brightness_down",
    	"on-scroll-up": "swaymsg exec \\$brightness_up",
		"tooltip": false,
    },

    "idle_inhibitor": {
    	"format": "{icon}",
    	"tooltip": false,
    	"format-icons": {
    		"activated": "󰒳",
    		"deactivated": "󰒲"
    	}
    },
    
	"custom/playerctl": {
		"interval": "once",
		"tooltip": true,
		"return-type": "json",
		"format" : "{icon}",
		"format-icons": {
			"Playing": "󰐌",
			"Paused": "󰏥"
		},
		"exec": "playerctl metadata --format '{\"alt\": \"{{status}}\", \"tooltip\": \"{{playerName}}:  {{markup_escape(title)}} - {{markup_escape(artist)}}\" }'",
		"on-click": "playerctl play-pause; pkill -RTMIN+5 waybar",
		"on-click-right": "playerctl next; pkill -RTMIN+5 waybar",
		"on-scroll-up": "playerctl position 10+; pkill -RTMIN+5 waybar",
		"on-scroll-down": "playerctl position 10-; pkill -RTMIN+5 waybar",
		"signal": 5
	},

	"custom/sunset": {
		"interval": "once",
		"tooltip": false,
		"return-type": "json",
		"format" : "{icon}",
		"format-icons": {
			"on": "󱩷" ,
			"off": "󱓤"
		},
		"exec": "~/.config/sway/scripts/sunset.sh",
		"on-click": "~/.config/sway/scripts/sunset.sh toggle; pkill -RTMIN+6 waybar",
		"exec-if": "~/.config/sway/scripts/sunset.sh check",
		"signal": 6
	},
	
	"custom/scratchpad": {
		"interval": "once",
		"return-type": "json",
		"format" : "{icon}",
		"format-icons": {
			"one": "",
			"many": ""
		},
		"exec": "~/.config/sway/scripts/scratchpad.sh",
		"on-click": "swaymsg 'scratchpad show'",
		"signal": 7
	},

	"custom/screencast": {
		"interval": "once",
		"tooltip": false,
		"return-type": "json",
		"format" : "{icon}",
		"format-icons": {
			"run": ""
		},
		"exec": "sleep 0.5 && pkill -0 wf-recorder && echo '{\"alt\":\"run\"}' || echo '{\"alt\":\"stop\"}'",
		"on-click": "killall -s SIGINT wf-recorder && pkill -RTMIN+8 waybar",
		"signal": 8
	},
	
	"custom/pacman": {
		"format": "󰀼 {}",
		"interval": 3600,
		"tooltip": false,
		"exec-if": "[ $(pamac checkupdates -q | wc -l) -gt 0 ]",
		"exec": "pamac checkupdates -q | wc -l",
		"on-click": "pamac-manager --updates; pkill -SIGRTMIN+8 waybar",
	},
	
	"cpu": {
		"interval": 5,
		"format": "󰍛 {usage}%", // Icon: microchip
		"states": {
			"warning": 70,
			"critical": 90
		},
		"on-click": "swaymsg exec \\$term_float btop"
	},

	"memory": {
		"interval": 5,
		//"min-length": 5,
		"format": "󰘚 {}%", // Icon: memory
		"states": {
			"warning": 70,
			"critical": 90
		},
		"on-click": "swaymsg exec \\$term_float btop"
	},
}
