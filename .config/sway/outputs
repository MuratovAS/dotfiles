# You can get the names of your outputs by running: swaymsg -t get_outputs

output * bg $background fill

workspace 9 output eDP-1

workspace 1 output HDMI-A-1
#output HDMI-A-1 pos 0 0 scale 2
output HDMI-A-1 adaptive_sync on


workspace 1 output DP-1
output DP-1 pos 0 0 scale 2
output DP-1 mode 3840x2160@40Hz
#output DP-1 mode 3840x2160@60Hz
#output DP-1 adaptive_sync on

workspace 1 output DP-2
output DP-2 pos 0 0 scale 2
#output DP-2 mode 3840x2160@40Hz
output DP-2 mode 3840x2160@60Hz
output DP-2 adaptive_sync on

