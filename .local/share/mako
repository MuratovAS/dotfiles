# default config for the mako notification daemon

layer=overlay
text-color=#c2beb4
font=RobotoMono 12

background-color=#2D353Be6
border-radius=0
width=300
height=120
padding=20
margin=20
markup=1
actions=1

icons=1
max-icon-size=48
default-timeout=5000

border-size=0

[urgency=high]
border-size=2
border-color=#E67E80
